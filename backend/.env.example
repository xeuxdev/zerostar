# Copy this file to .env and fill in your values.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
# gpt-4o-mini is the default; swap for gpt-4o, gpt-4-turbo, etc. as needed.
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Max requests per IP before they get "Go get a job."
RATE_LIMIT_REQUESTS=10
# Window in seconds over which that budget is measured.
RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ───────────────────────────────────────────────────────────────────────
# The origin of your frontend – adjust for production.
ALLOWED_ORIGIN=http://localhost:3000
